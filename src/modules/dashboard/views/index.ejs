<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102b46">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Panel | HotelReserve Pro</title>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/dashboard" aria-label="HotelReserve Pro, inicio">
        <span class="brand-mark" aria-hidden="true">H</span>
        <span>HotelReserve <strong>Pro</strong></span>
      </a>
      <p class="nav-heading">PRINCIPAL</p>
      <nav aria-label="Navegación principal">
        <a class="nav-link active" href="/dashboard"><span class="nav-icon">01</span> Panel general</a>
        <a class="nav-link" href="/reservations"><span class="nav-icon">02</span> Reservas</a>
        <a class="nav-link" href="/rooms"><span class="nav-icon">03</span> Habitaciones</a>
        <a class="nav-link" href="/guests"><span class="nav-icon">04</span> Huéspedes</a>
        <a class="nav-link" href="/availability"><span class="nav-icon">05</span> Disponibilidad</a>
        <span class="nav-link disabled"><span class="nav-icon">05</span> Pagos <small>Próximamente</small></span>
      </nav>
      <div class="sidebar-bottom">
        <div class="hotel-label">
          <span class="hotel-dot"></span>
          <span><strong>Hotel El Turista</strong><small>Panel de administración</small></span>
        </div>
        <p id="logout-error" class="logout-error" role="alert" aria-live="polite"></p>
        <button class="logout-button" id="logout-button" type="button">Cerrar sesión</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <button class="menu-button" id="menu-button" type="button" aria-label="Abrir menú">☰</button>
        <div class="breadcrumb">HotelReserve Pro <span>/</span> Panel general</div>
        <div class="user-menu">
          <span class="user-avatar">A</span>
          <span class="user-details"><strong><%= user.username %></strong><small><%= user.role === 'admin' ? 'Administrador' : 'Recepcionista' %></small></span>
        </div>
      </header>

      <section class="page-content">
        <div class="page-heading">
          <div>
            <p class="eyebrow">RESUMEN DE OPERACIÓN</p>
            <h1>Panel general</h1>
            <p class="welcome">Bienvenido, <strong><%= user.username %></strong>. Aquí tienes el estado actual de tu hotel.</p>
          </div>
          <span class="date-chip" id="today-date"></span>
        </div>

        <div class="status-banner">
          <span class="status-indicator"></span>
          <div><strong>Gestión de habitaciones disponible</strong><p>Administra habitaciones y sus estados físicos desde el menú lateral.</p></div>
        </div>

        <section aria-labelledby="metrics-title">
          <div class="section-heading">
            <div><h2 id="metrics-title">Indicadores clave</h2><p>Resumen actual de la operación hotelera</p></div>
            <span class="data-label">SQL Server</span>
          </div>
          <p id="summary-error" class="inline-error" role="alert" aria-live="polite"></p>
          <div class="metrics-grid">
            <article class="metric-card">
              <div class="metric-top"><span>Total habitaciones</span><span class="metric-icon blue">T</span></div>
              <strong class="metric-value" data-metric="totalRooms">—</strong><span class="metric-note">Registradas en el hotel</span>
            </article>
            <article class="metric-card">
              <div class="metric-top"><span>Reservas de hoy</span><span class="metric-icon blue">R</span></div>
              <strong class="metric-value" data-metric="reservationsToday">—</strong><span class="metric-note">Entradas programadas</span>
            </article>
            <article class="metric-card">
              <div class="metric-top"><span>Reservas pendientes</span><span class="metric-icon amber">P</span></div>
              <strong class="metric-value" data-metric="pendingReservations">—</strong><span class="metric-note">Requieren seguimiento</span>
            </article>
            <article class="metric-card">
              <div class="metric-top"><span>Físicamente disponibles</span><span class="metric-icon green">H</span></div>
              <strong class="metric-value" data-metric="availableRooms">—</strong><span class="metric-note">Listas para asignar</span>
            </article>
            <article class="metric-card">
              <div class="metric-top"><span>Habitaciones ocupadas</span><span class="metric-icon violet">O</span></div>
              <strong class="metric-value" data-metric="occupiedRooms">—</strong><span class="metric-note">En uso actualmente</span>
            </article>
            <article class="metric-card">
              <div class="metric-top"><span>En mantenimiento</span><span class="metric-icon amber">M</span></div>
              <strong class="metric-value" data-metric="maintenanceRooms">—</strong><span class="metric-note">No disponibles para operación</span>
            </article>
          </div>
        </section>

        <div class="lower-grid">
          <section class="panel-card">
            <div class="section-heading compact"><div><h2>Actividad reciente</h2><p>Últimos movimientos del sistema</p></div></div>
            <div class="empty-state"><span class="empty-mark">—</span><strong>Sin actividad por ahora</strong><p>Cuando registres operaciones, aparecerán aquí.</p></div>
          </section>
          <section class="panel-card quick-panel">
            <div class="section-heading compact"><div><h2>Accesos rápidos</h2><p>Funciones disponibles en esta versión</p></div></div>
            <a class="quick-link" href="/rooms"><span class="quick-symbol">01</span><span><strong>Gestionar habitaciones</strong><small>Crear, consultar y actualizar habitaciones</small></span><span class="quick-arrow">›</span></a>
            <a class="quick-link" href="/reservations"><span class="quick-symbol">02</span><span><strong>Gestionar reservas</strong><small>Crear y administrar estadías</small></span><span class="quick-arrow">›</span></a>
            <a class="quick-link" href="/availability"><span class="quick-symbol">03</span><span><strong>Consultar disponibilidad</strong><small>Buscar por fechas y huéspedes</small></span><span class="quick-arrow">›</span></a>
          </section>
        </div>
        <footer class="page-footer">HotelReserve Pro <span>·</span> Versión 1.0.0</footer>
      </section>
    </main>
  </div>
  <div class="mobile-scrim" id="mobile-scrim"></div>
  <script src="/js/dashboard.js" defer></script>
</body>
</html>
