<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102b46">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Iniciar sesión | HotelReserve Pro</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="login-layout">
    <section class="brand-panel" aria-label="HotelReserve Pro">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">H</span>
        <span>HotelReserve <strong>Pro</strong></span>
      </div>
      <div class="brand-copy">
        <p class="eyebrow">GESTIÓN HOTELERA</p>
        <h1>Todo tu hotel,<br>en un solo lugar.</h1>
        <p>Administra la operación diaria de forma clara, segura y organizada.</p>
      </div>
      <p class="brand-footnote">Plataforma de administración hotelera</p>
    </section>

    <section class="form-panel">
      <div class="login-card">
        <p class="eyebrow">BIENVENIDO</p>
        <h2>Iniciar sesión</h2>
        <p class="form-intro">Ingresa tus credenciales para continuar al panel de administración.</p>

        <form id="login-form" novalidate>
          <label for="username">Usuario</label>
          <input id="username" name="username" type="text" autocomplete="username"
            placeholder="Escribe tu usuario" required>

          <div class="password-label">
            <label for="password">Contraseña</label>
          </div>
          <input id="password" name="password" type="password" autocomplete="current-password"
            placeholder="Escribe tu contraseña" required>

          <p id="login-error" class="form-error" role="alert" aria-live="polite"></p>
          <button id="login-button" type="submit">
            <span>Entrar al panel</span>
            <span aria-hidden="true">→</span>
          </button>
        </form>
        <p class="initial-access">Acceso predeterminado (sin cambios en .env): <strong>admin</strong> / <strong>admin123</strong></p>
        <p class="security-note">Acceso protegido mediante autenticación segura.</p>
      </div>
    </section>
  </main>
  <script src="/js/auth.js" defer></script>
</body>
</html>
