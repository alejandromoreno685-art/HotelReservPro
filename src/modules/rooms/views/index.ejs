<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102b46">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Habitaciones | HotelReserve Pro</title>
  <link rel="stylesheet" href="/css/rooms.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/dashboard" aria-label="HotelReserve Pro, inicio">
        <span class="brand-mark" aria-hidden="true">H</span>
        <span>HotelReserve <strong>Pro</strong></span>
      </a>
      <p class="nav-heading">PRINCIPAL</p>
      <nav aria-label="Navegación principal">
        <a class="nav-link" href="/dashboard"><span class="nav-icon">01</span> Panel general</a>
        <a class="nav-link" href="/reservations"><span class="nav-icon">02</span> Reservas</a>
        <a class="nav-link active" href="/rooms"><span class="nav-icon">03</span> Habitaciones</a>
        <a class="nav-link" href="/guests"><span class="nav-icon">04</span> Huéspedes</a>
        <a class="nav-link" href="/availability"><span class="nav-icon">05</span> Disponibilidad</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="hotel-label">
          <span class="hotel-dot"></span>
          <span><strong>Hotel El Turista</strong><small>Panel de administración</small></span>
        </div>
        <p id="logout-error" class="logout-error" role="alert" aria-live="polite"></p>
        <button class="logout-button" id="logout-button" type="button">Cerrar sesión</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <button class="menu-button" id="menu-button" type="button" aria-label="Abrir menú">☰</button>
        <div class="breadcrumb">HotelReserve Pro <span>/</span> Habitaciones</div>
        <div class="user-menu">
          <span class="user-avatar">A</span>
          <span class="user-details"><strong><%= user.username %></strong><small><%= user.role === 'admin' ? 'Administrador' : 'Recepcionista' %></small></span>
        </div>
      </header>

      <section class="page-content">
        <div class="page-heading">
          <div>
            <p class="eyebrow">INVENTARIO DEL HOTEL</p>
            <h1>Habitaciones</h1>
            <p class="welcome">Administra tipos, capacidad, tarifa y estado físico de tus habitaciones.</p>
          </div>
          <button class="primary-button" id="new-room-button" type="button"><span aria-hidden="true">＋</span> Nueva habitación</button>
        </div>

        <section class="summary-grid" aria-label="Resumen de habitaciones">
          <article class="summary-card"><span>Total registradas</span><strong id="total-count">0</strong></article>
          <article class="summary-card"><span>Disponibles</span><strong id="available-count">0</strong></article>
          <article class="summary-card"><span>En limpieza</span><strong id="cleaning-count">0</strong></article>
          <article class="summary-card"><span>Mantenimiento</span><strong id="maintenance-count">0</strong></article>
        </section>

        <p class="page-message" id="page-message" role="status" aria-live="polite"></p>

        <section class="panel-card" aria-labelledby="rooms-title">
          <div class="panel-heading">
            <div><h2 id="rooms-title">Inventario de habitaciones</h2><p>Los cambios se guardan en SQL Server.</p></div>
            <span class="data-label">SQL Server</span>
          </div>
          <div class="filters">
            <label class="search-field" for="search-input"><span aria-hidden="true">⌕</span>
              <input id="search-input" type="search" placeholder="Buscar por número o descripción">
            </label>
            <label class="filter-field" for="status-filter">
              <span>Estado</span>
              <select id="status-filter">
                <option value="">Todos los estados</option>
                <option value="DISPONIBLE">Disponible</option>
                <option value="EN_LIMPIEZA">En limpieza</option>
                <option value="MANTENIMIENTO">Mantenimiento</option>
                <option value="FUERA_DE_SERVICIO">Fuera de servicio</option>
              </select>
            </label>
            <label class="filter-field" for="type-filter">
              <span>Tipo</span>
              <select id="type-filter">
                <option value="">Todos los tipos</option>
                <option value="ESTANDAR">Estándar</option>
                <option value="DOBLE">Doble</option>
                <option value="FAMILIAR">Familiar</option>
                <option value="SUITE">Suite</option>
              </select>
            </label>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Habitación</th><th>Tipo</th><th>Capacidad</th><th>Tarifa / noche</th><th>Estado físico</th><th><span class="sr-only">Acciones</span></th></tr></thead>
              <tbody id="rooms-table-body"></tbody>
            </table>
          </div>
          <div class="empty-state" id="empty-state" hidden>
            <span class="empty-mark" aria-hidden="true">H</span>
            <strong id="empty-title">Todavía no hay habitaciones</strong>
            <p id="empty-description">Registra habitaciones para empezar a preparar el inventario del hotel.</p>
          </div>
        </section>
        <footer class="page-footer">HotelReserve Pro <span>·</span> Versión 1.0.0</footer>
      </section>
    </main>
  </div>
  <div class="mobile-scrim" id="mobile-scrim"></div>

  <dialog class="room-dialog" id="room-dialog" aria-labelledby="form-title">
    <form id="room-form">
      <div class="dialog-heading">
        <div><p class="eyebrow">INVENTARIO DEL HOTEL</p><h2 id="form-title">Nueva habitación</h2></div>
        <button class="icon-button" id="close-dialog-button" type="button" aria-label="Cerrar formulario">×</button>
      </div>
      <p class="dialog-intro">Completa los datos de la habitación. La tarifa se expresa en pesos colombianos por noche.</p>
      <div class="form-grid">
        <label for="room-number">Número o código
          <input id="room-number" name="number" type="text" maxlength="12" pattern="[A-Za-z0-9\-]{1,12}" placeholder="Ej. 101" required>
        </label>
        <label for="room-type">Tipo de habitación
          <select id="room-type" name="type" required>
            <option value="">Selecciona un tipo</option>
            <option value="ESTANDAR">Estándar</option>
            <option value="DOBLE">Doble</option>
            <option value="FAMILIAR">Familiar</option>
            <option value="SUITE">Suite</option>
          </select>
        </label>
        <label for="room-capacity">Capacidad de huéspedes
          <input id="room-capacity" name="capacity" type="number" min="1" max="12" step="1" placeholder="Ej. 2" required>
        </label>
        <label for="room-rate">Tarifa por noche (COP)
          <input id="room-rate" name="rate" type="number" min="1" step="1" placeholder="Ej. 180000" required>
        </label>
        <label for="room-status">Estado físico
          <select id="room-status" name="status" required>
            <option value="DISPONIBLE">Disponible</option>
            <option value="EN_LIMPIEZA">En limpieza</option>
            <option value="MANTENIMIENTO">Mantenimiento</option>
            <option value="FUERA_DE_SERVICIO">Fuera de servicio</option>
          </select>
        </label>
        <label class="description-field" for="room-description">Descripción <span>Opcional</span>
          <textarea id="room-description" name="description" maxlength="250" rows="3" placeholder="Características o notas de la habitación"></textarea>
        </label>
      </div>
      <p class="form-error" id="form-error" role="alert" aria-live="polite"></p>
      <div class="dialog-actions">
        <button class="secondary-button" id="cancel-dialog-button" type="button">Cancelar</button>
        <button class="primary-button" id="save-room-button" type="submit">Guardar habitación</button>
      </div>
    </form>
  </dialog>
  <script src="/js/rooms.js" defer></script>
</body>
</html>
